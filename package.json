{
  "name": "toy-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node tests/league.test.js && node tests/presentation.test.js && node tests/countries-cache.test.js",
    "dev:full": "npm run build:local && wrangler pages dev dist --persist-to .wrangler/state",
    "build": "vite build",
    "build:local": "vite build --base /",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "wrangler": "3.80.4"
  }
}
